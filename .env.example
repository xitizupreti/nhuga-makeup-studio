# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# The Gmail account that sends the booking enquiries.
GMAIL_USER=studio.account@gmail.com

# A Google App Password (16 chars), NOT the normal Gmail password.
# Requires 2-Step Verification on the account:
# https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to GMAIL_USER if left unset.
BOOKING_TO=studio.account@gmail.com

# Only needed when moving off the Vercel URL to a custom domain.
# Used for canonical links, the sitemap and link previews.
# NEXT_PUBLIC_SITE_URL=https://nhugamakeupstudio.com.np
